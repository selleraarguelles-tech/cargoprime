generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id             Int            @id @default(autoincrement())
  nombre         String
  email          String         @unique
  telefono       String?
  createdAt      DateTime       @default(now())
  productos      Producto[]
  pedidos        Pedido[]
  cuentasAmazon  CuentaAmazon[]
  cuentasTikTok  CuentaTikTok[]
  cuentasShopify CuentaShopify[]
  envios         Envio[]
  usuarios       User[]
  rateCard       RateCard?
  facturas       Factura[]
  devoluciones   Devolucion[]
  transportistas PreferenciaTransportista[]
}

model PreferenciaTransportista {
  id            Int     @id @default(autoincrement())
  clienteId     Int
  canal         String  // 'amazon' | 'tiktok' | 'shopify'
  transportista String  // 'ctt' | 'cex'
  cliente       Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, canal])
}

model RateCard {
  id                  Int      @id @default(autoincrement())
  clienteId           Int      @unique
  cuotaMensual        Float    @default(0)
  tarifaPedido        Float    @default(0)
  tarifaRecepcion     Float    @default(0)
  tarifaUnidadAlmacen Float    @default(0)
  iva                 Float    @default(21)
  updatedAt           DateTime @updatedAt
  cliente             Cliente  @relation(fields: [clienteId], references: [id])
}

model Factura {
  id        Int            @id @default(autoincrement())
  clienteId Int
  periodo   String         // 'YYYY-MM'
  estado    String         @default("borrador") // borrador | emitida | pagada
  subtotal  Float          @default(0)
  iva       Float          @default(0)
  total     Float          @default(0)
  createdAt DateTime       @default(now())
  cliente   Cliente        @relation(fields: [clienteId], references: [id])
  lineas    FacturaLinea[]

  @@unique([clienteId, periodo])
}

model FacturaLinea {
  id             Int     @id @default(autoincrement())
  facturaId      Int
  concepto       String
  cantidad       Float
  precioUnitario Float
  importe        Float
  factura        Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)
}

model Envio {
  id             Int       @id @default(autoincrement())
  clienteId      Int
  transportista  String
  trackingNumber String
  descripcion    String?
  fechaEsperada  DateTime?
  estado         String    @default("en_transito")
  ultimoEvento   String?
  ultimaRevision DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  cliente        Cliente   @relation(fields: [clienteId], references: [id])
}

model CuentaAmazon {
  id            Int       @id @default(autoincrement())
  nombre        String
  sellerId      String    @unique
  marketplaceId String    @default("A1RKKUPIHCS9HS")
  clienteId     Int
  refreshToken  String
  isSandbox     Boolean   @default(false)
  activo        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  cliente       Cliente   @relation(fields: [clienteId], references: [id])
}

model CuentaTikTok {
  id           Int      @id @default(autoincrement())
  nombre       String
  shopId       String   @unique
  shopCipher   String?
  clienteId    Int
  accessToken  String
  refreshToken String
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cliente      Cliente  @relation(fields: [clienteId], references: [id])
}

model CuentaShopify {
  id          Int      @id @default(autoincrement())
  nombre      String
  shopDomain  String   @unique
  clienteId   Int
  accessToken String
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
}

model Producto {
  id           Int               @id @default(autoincrement())
  sku          String            @unique
  nombre       String
  clienteId    Int
  stockActual         Int               @default(0)
  stockMinimo         Int               @default(50)
  notificadoStockBajo Boolean           @default(false)
  precioVenta         Float             @default(0)
  costeUnitario       Float             @default(0)
  comisionAmazon      Float             @default(15)
  createdAt           DateTime          @default(now())
  cliente             Cliente           @relation(fields: [clienteId], references: [id])
  pedidos             Pedido[]
  movimientos         MovimientoStock[]
}

model Pedido {
  id                    Int      @id @default(autoincrement())
  amazonOrderId         String   @unique
  canal                 String   @default("amazon")
  clienteId             Int
  productoId            Int
  destinatarioNombre    String
  destinatarioDireccion String
  destinatarioCP        String
  destinatarioCiudad    String
  destinatarioPais      String   @default("España")
  peso                  Float?
  cantidad              Int      @default(1)
  importe               Float?
  moneda                String?
  transportista         String?
  trackingNumber        String?
  trackingEstado        String?
  estado                String   @default("sin_etiqueta")
  enviadoAt             DateTime?
  entregadoAt           DateTime?
  cttReclamadoAt        DateTime?
  amazonConfirmadoAt    DateTime?
  amazonFeedId          String?
  createdAt             DateTime @default(now())
  cliente               Cliente  @relation(fields: [clienteId], references: [id])
  producto              Producto @relation(fields: [productoId], references: [id])
  devoluciones          Devolucion[]
}

model Devolucion {
  id          Int       @id @default(autoincrement())
  pedidoId    Int
  clienteId   Int
  motivo      String?
  estado      String    @default("solicitada") // solicitada | recibida | reembolsada | rechazada
  reingresado Boolean   @default(false)
  notas       String?
  createdAt   DateTime  @default(now())
  recibidaAt  DateTime?
  pedido      Pedido    @relation(fields: [pedidoId], references: [id])
  cliente     Cliente   @relation(fields: [clienteId], references: [id])
}

model MovimientoStock {
  id         Int      @id @default(autoincrement())
  productoId Int
  tipo       String
  cantidad   Int
  nota       String?
  createdAt  DateTime @default(now())
  producto   Producto @relation(fields: [productoId], references: [id])
}

model Configuracion {
  clave String @id
  valor String
}

model User {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  email            String    @unique
  password         String
  nombre           String
  rol              String    @default("readonly")
  activo           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  clienteId        Int?
  cliente          Cliente?  @relation(fields: [clienteId], references: [id])
}
